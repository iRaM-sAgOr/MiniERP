# Backend runtime environment
APP_URL="http://localhost:8080"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://<YOUR_IP>:3000"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# Default non-docker (SQLite)
DATABASE_URL="file:./dev.db"

# Docker local PostgreSQL (used by docker-compose.local.yml):
# DATABASE_URL="postgresql://minierp:minierp_password_2025_ai_solution_usa@localhost:5432/minierp?schema=public"

# Cloud PostgreSQL example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public&sslmode=require"

# Supabase Storage (required for profile avatar uploads)
# Project URL — Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL="https://<your-project-ref>.supabase.co"
# service_role secret key — Supabase Dashboard → Project Settings → API → service_role (keep server-side only!)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Name of the public storage bucket created in Supabase → Storage
SUPABASE_STORAGE_BUCKET="avatars"
