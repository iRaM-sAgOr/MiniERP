{
  "name": "minierp-root",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=minierp-frontend",
    "dev:backend": "npm run dev --workspace=minierp-backend",
    "lint": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "prisma:generate": "npm run prisma:generate --workspace=minierp-backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=minierp-backend",
    "prisma:deploy": "npm run prisma:deploy --workspace=minierp-backend",
    "prisma:seed": "npm run prisma:seed --workspace=minierp-backend",
    "setup": "npm install && npm run prisma:generate --workspace=minierp-backend && npm run prisma:migrate --workspace=minierp-backend && npm run prisma:seed --workspace=minierp-backend"
  },
  "devDependencies": {
    "typescript": "~5.8.2"
  }
}
